# Supabase (not connected in the local demo)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps: enable Maps JavaScript API and Geocoding API, then rebuild.
# Use a browser key restricted to your own website origins.
# Local referrers: http://127.0.0.1:4173/* and http://localhost:4173/*
# Leave empty for Google map browsing only; search and pin sync need the key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
