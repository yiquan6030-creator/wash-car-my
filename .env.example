# Supabase Configuration for WashCar MY
# Copy this file to .env and fill in your Supabase project credentials
# Find these in Supabase Dashboard -> Project Settings -> API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional production map/geocoding providers (public URLs only, never secret keys)
# Defaults use OpenStreetMap standard tiles and user-triggered Nominatim queries.
# EXPO_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_GEOCODING_URL=https://nominatim.openstreetmap.org
